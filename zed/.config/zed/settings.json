// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "deepagents": {
      "default_mode": "ask",
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "gemini": {
      "default_mode": "default",
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "qwen3.6:latest",
      "enable_thinking": false
    },
    "dock": "right",
    "default_model": {
      "provider": "google",
      "model": "gemini-3.1-pro-preview",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ssh_connections": [
    {
      "host": "wilma",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/alumnos/cap/cap-2"
          ]
        },
        {
          "paths": [
            "/home/alumnos/cap/cap-2/Exercicis"
          ]
        }
      ]
    },
    {
      "host": "aolin",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/alumnos/cap/cap-2/PRACTICA1"
          ]
        },
        {
          "paths": [
            "/home/alumnos/cap/cap-2/cuda-torn2_grup3-3"
          ]
        }
      ]
    }
  ],
  "languages": {
    "C++": {
      "format_on_save": "on",
      "preferred_line_length": 100,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "disable_ai": false,
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    },
    "mode": "subtle",
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": false,
    "hide_gitignore": true,
    "default_width": 300.0,
  },
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "ui_font_size": 20,
  "buffer_font_size": 18,
  "theme": "Gruvbox Dark Soft",
  "hidden_files": ["**/.*", "*.uid", "*.import", "shaders/"],
  "relative_line_numbers": "enabled",
}
