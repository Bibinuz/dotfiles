@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @on-surface;
    margin: 0;
    padding: 0;
}

window {
    width: 650px;
    background-color: @surface-container;
    border-radius: 20px;
    padding: 20px;
    /* Ensure no default border colors leak through */
    border: 0px; 
    border-color: @primary;
}

mainbox {
    spacing: 15px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 12px 16px;
    background-color: @surface-container-high;
    border-radius: 999px;
    children: [ "entry" ];
    border: 0px;
}

entry {
    text-color: @on-surface;
    cursor: text;
    placeholder: "Search...";
    placeholder-color: @on-surface-variant;
}

listview {
    lines: 7;
    spacing: 5px;
    margin: 5px 0 0 0;
    fixed-height: true;
    border: 0px;
    scrollbar: false;
}

element {
    padding: 10px 16px;
    spacing: 10px;
    border-radius: 999px;
    border: 0px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @secondary-container;
    text-color: @on-secondary-container;
}

element normal.active,
element alternate.active {
    text-color: @primary;
}

element selected.active {
    background-color: @secondary-container;
    text-color: @on-secondary-container;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
